# Data Pipeline Intelligence - example configuration
# Copy to .env and adjust. All variables are optional; defaults are shown.
# No secrets are required to run the application.

# --- Uploads / limits ---
# Maximum accepted upload size in bytes (default: 5 MiB).
ADFPI_MAX_UPLOAD_BYTES=5242880

# Comma-separated list of accepted upload file extensions.
ADFPI_ALLOWED_EXTENSIONS=.json

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
ADFPI_LOG_LEVEL=INFO
# "text" or "json"
ADFPI_LOG_FORMAT=text

# --- App ---
ADFPI_APP_TITLE=Data Pipeline Intelligence

# --- Error Analyzer: opt-in unrecognized-error capture ---
# When unset (default), the "Flag this error" button doesn't appear anywhere and
# nothing is ever written to disk. Set this to a file path to let a user explicitly
# flag an error the analyzer didn't recognize; the text is best-effort redacted
# (app/insights/error_feedback.py) before being appended as one JSON line, so a
# maintainer can review it and add a pattern to app/insights/error_patterns.json.
# This is the ONLY setting that enables any persistence in the app.
# ADFPI_ERROR_MISSES_PATH=./data/error_misses.jsonl
