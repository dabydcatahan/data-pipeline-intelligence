# Data Pipeline Intelligence - example configuration
# Copy to .env and adjust. All variables are optional; defaults are shown.
# No secrets are required to run the application.

# --- Uploads / limits ---
# Maximum accepted upload size in bytes (default: 5 MiB).
ADFPI_MAX_UPLOAD_BYTES=5242880

# Comma-separated list of accepted upload file extensions.
ADFPI_ALLOWED_EXTENSIONS=.json

# --- Logging ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
ADFPI_LOG_LEVEL=INFO
# "text" or "json"
ADFPI_LOG_FORMAT=text

# --- AI insights (enhancement layer only; deterministic engine is authoritative) ---
# When false, only the offline DeterministicInsightProvider is used.
ADFPI_ENABLE_LLM_INSIGHTS=false
# Provider id when LLM insights are enabled (e.g. "anthropic").
ADFPI_LLM_PROVIDER=
# Model id for the selected provider.
ADFPI_LLM_MODEL=
# API key for the selected provider. Leave empty unless LLM insights are enabled.
# NEVER commit a real key.
ADFPI_LLM_API_KEY=

# --- App ---
ADFPI_APP_TITLE=Data Pipeline Intelligence
